APP_NAME="Hub Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Informe proxies confiáveis apenas quando a aplicação estiver atrás de proxy reverso.
# Para um túnel HTTPS local controlado: TRUSTED_PROXIES=*
TRUSTED_PROXIES=
ADMIN_URL=http://localhost:8000
SUPERADMIN_URL=http://localhost:8000/superadmin

# URL pública e estável registrada nos aplicativos OAuth (sem domínio de loja).
PROVIDER_CONNECTION_REDIRECT_BASE_URL=
# Configure valores reais apenas no .env local ou no Secret Manager da infraestrutura:
# MERCADO_PAGO_PLATFORM_CLIENT_ID=
# MERCADO_PAGO_PLATFORM_CLIENT_SECRET=
# PAGBANK_PLATFORM_CLIENT_ID=
# PAGBANK_PLATFORM_CLIENT_SECRET=
# Melhor Envio: credenciais distintas por ambiente. Não use as variáveis legadas PLATFORM.
# MELHOR_ENVIO_SANDBOX_CLIENT_ID=
# MELHOR_ENVIO_SANDBOX_CLIENT_SECRET=
# MELHOR_ENVIO_PRODUCTION_CLIENT_ID=
# MELHOR_ENVIO_PRODUCTION_CLIENT_SECRET=
# MELHOR_ENVIO_PLATFORM_USER_AGENT="Hub Commerce (suporte@seu-dominio.com)"
# STRIPE_CONNECT_PLATFORM_SECRET_KEY=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hub_commerce
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SANCTUM_EXPIRATION_MINUTES=60
SANCTUM_TOKEN_PREFIX=hub_

# Identidade, equipes e permissões
IDENTITY_LEGACY_ADMIN_ACCESS=true
IDENTITY_INVITATION_EXPIRATION_HOURS=168
MFA_ISSUER="${APP_NAME}"
MFA_RECOVERY_CODE_COUNT=8
# Use required somente depois que todos os administradores tiverem MFA configurado.
MFA_ENFORCEMENT=optional

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
